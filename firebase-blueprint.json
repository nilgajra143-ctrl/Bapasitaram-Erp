{
  "entities": {
    "Vehicle": {
      "title": "Vehicle",
      "description": "Fleet vehicle registered under BAPASITARAM ENTERPRISE.",
      "type": "object",
      "properties": {
        "registrationNumber": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20,
          "pattern": "^[A-Z0-9\\-\\s]{4,20}$",
          "description": "Official RTO vehicle registration number (e.g. GJ-03-BW-4521)."
        },
        "vehicleType": {
          "type": "string",
          "enum": ["Truck", "Trailer", "Container", "Tanker", "Tipper", "LCV", "Other"],
          "description": "Commercial vehicle body category."
        },
        "makeModel": {
          "type": "string",
          "maxLength": 80,
          "description": "Manufacturer and model name."
        },
        "capacityTons": {
          "type": "number",
          "description": "Payload capacity in metric tons."
        },
        "driverName": {
          "type": "string",
          "maxLength": 80,
          "description": "Assigned primary driver full name."
        },
        "driverPhone": {
          "type": "string",
          "maxLength": 20,
          "description": "Primary driver contact number."
        },
        "fitnessExpiry": {
          "type": "string",
          "maxLength": 20,
          "description": "Fitness certificate expiry date (YYYY-MM-DD)."
        },
        "insuranceExpiry": {
          "type": "string",
          "maxLength": 20,
          "description": "Insurance policy expiry date (YYYY-MM-DD)."
        },
        "permitExpiry": {
          "type": "string",
          "maxLength": 20,
          "description": "National or state permit expiry date (YYYY-MM-DD)."
        },
        "pucExpiry": {
          "type": "string",
          "maxLength": 20,
          "description": "PUC certificate expiry date (YYYY-MM-DD)."
        },
        "taxExpiry": {
          "type": "string",
          "maxLength": 20,
          "description": "Road / Permit tax expiry date (YYYY-MM-DD)."
        },
        "status": {
          "type": "string",
          "enum": ["Available", "On Trip", "Maintenance", "Inactive"],
          "description": "Current operational status of the vehicle."
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Operational remarks for the vehicle."
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated user UID owning the record."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "registrationNumber",
        "vehicleType",
        "makeModel",
        "capacityTons",
        "driverName",
        "driverPhone",
        "fitnessExpiry",
        "insuranceExpiry",
        "permitExpiry",
        "status",
        "notes",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "Party": {
      "title": "Party",
      "description": "Client, consignor, consignee, or transport broker account.",
      "type": "object",
      "properties": {
        "partyName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Registered business or party name."
        },
        "partyType": {
          "type": "string",
          "enum": ["Consignor", "Consignee", "Broker", "Both"],
          "description": "Commercial role of the party."
        },
        "contactPerson": {
          "type": "string",
          "maxLength": 80,
          "description": "Primary billing or dispatch contact person."
        },
        "phone": {
          "type": "string",
          "maxLength": 20,
          "description": "Primary contact telephone number."
        },
        "email": {
          "type": "string",
          "maxLength": 120,
          "description": "Billing email address."
        },
        "gstin": {
          "type": "string",
          "maxLength": 20,
          "description": "15-character Indian GSTIN if registered."
        },
        "city": {
          "type": "string",
          "maxLength": 80,
          "description": "City of operation."
        },
        "state": {
          "type": "string",
          "maxLength": 80,
          "description": "State of operation."
        },
        "address": {
          "type": "string",
          "maxLength": 300,
          "description": "Registered billing or office address."
        },
        "paymentTermsDays": {
          "type": "number",
          "description": "Agreed credit period in days."
        },
        "status": {
          "type": "string",
          "enum": ["Active", "Inactive"],
          "description": "Account operational status."
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Internal credit or dispatch notes."
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated user UID owning the record."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "partyName",
        "partyType",
        "contactPerson",
        "phone",
        "email",
        "gstin",
        "city",
        "state",
        "address",
        "paymentTermsDays",
        "status",
        "notes",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "Trip": {
      "title": "Trip",
      "description": "Transport trip dispatch and INR freight ledger entry aligned with Excel workbook columns.",
      "type": "object",
      "properties": {
        "srNo": {
          "type": "string",
          "maxLength": 30,
          "description": "Original Excel Sr No."
        },
        "lrNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Lorry Receipt (LR) / Bilty number."
        },
        "tripDate": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20,
          "description": "Dispatch date (YYYY-MM-DD)."
        },
        "vehicleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Referenced vehicle document ID."
        },
        "vehicleNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "description": "Vehicle registration number snapshot."
        },
        "partyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Referenced party document ID."
        },
        "partyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Party name snapshot."
        },
        "driverName": {
          "type": "string",
          "maxLength": 80,
          "description": "Driver assigned for the trip."
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Loading origin (From)."
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Unloading destination (To)."
        },
        "containerNo": {
          "type": "string",
          "maxLength": 40,
          "description": "Container number from Excel workbook."
        },
        "material": {
          "type": "string",
          "maxLength": 100,
          "description": "Cargo commodity or material description."
        },
        "weightTons": {
          "type": "number",
          "description": "Consignment weight in metric tons."
        },
        "freightAmount": {
          "type": "number",
          "description": "Total Rate / Freight charge in INR."
        },
        "advanceReceived": {
          "type": "number",
          "description": "Jama / Advance received in INR."
        },
        "dieselQuantity": {
          "type": "number",
          "description": "Diesel Quantity in Liters (kept strictly separate from Diesel Amount)."
        },
        "dieselRate": {
          "type": "number",
          "description": "Diesel rate per liter in INR snapshot at trip entry time."
        },
        "dieselExpense": {
          "type": "number",
          "description": "Diesel Amount in INR."
        },
        "tollExpense": {
          "type": "number",
          "description": "Toll expense in INR."
        },
        "driverAllowance": {
          "type": "number",
          "description": "Driver bhatta / allowance in INR."
        },
        "otherExpense": {
          "type": "number",
          "description": "Kharcha / other trip expense in INR."
        },
        "balanceAmount": {
          "type": "number",
          "description": "Hisab / Balance receivable in INR."
        },
        "totalExpense": {
          "type": "number",
          "description": "Sum of trip expenses in INR."
        },
        "tripStatus": {
          "type": "string",
          "enum": ["Scheduled", "In Transit", "Delivered", "Settled", "Cancelled"],
          "description": "Current trip lifecycle stage."
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["Unpaid", "Partial", "Paid"],
          "description": "Freight settlement state."
        },
        "podReceived": {
          "type": "boolean",
          "description": "Whether Proof of Delivery (POD) has been received."
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Note / trip remarks."
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated user UID owning the record."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "lrNumber",
        "tripDate",
        "vehicleId",
        "vehicleNumber",
        "partyId",
        "partyName",
        "driverName",
        "origin",
        "destination",
        "material",
        "weightTons",
        "freightAmount",
        "advanceReceived",
        "dieselExpense",
        "tollExpense",
        "driverAllowance",
        "otherExpense",
        "balanceAmount",
        "totalExpense",
        "tripStatus",
        "paymentStatus",
        "podReceived",
        "notes",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
